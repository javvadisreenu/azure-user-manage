# =============================================================================
# FRONTEND ENVIRONMENT — Microsoft Entra External ID
# Copy this file, fill in every value below, then restart the dev server.
# Never commit real values to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# VITE_ENTRA_CLIENT_ID
# The Application (client) ID of the React SPA app registration.
#
# How to find it:
#   1. Go to https://entra.microsoft.com
#   2. Switch to your External ID tenant (top-right Directories menu)
#   3. Navigate to: Entra ID → App registrations → <your SPA app>
#   4. Copy "Application (client) ID" from the Overview page
#
# Example:  a1b2c3d4-e5f6-7890-abcd-ef1234567890
# -----------------------------------------------------------------------------
VITE_ENTRA_CLIENT_ID=your-spa-client-id-here

# -----------------------------------------------------------------------------
# VITE_ENTRA_TENANT_SUBDOMAIN
# The subdomain of your External ID tenant — the part BEFORE .onmicrosoft.com
#
# How to find it:
#   1. Go to https://entra.microsoft.com
#   2. Switch to your External ID tenant
#   3. Navigate to: Entra ID → Overview
#   4. Look at "Primary domain" — e.g. mycompanycustomers.onmicrosoft.com
#   5. Use only the part before .onmicrosoft.com
#
# Example:  if domain = mycompanycustomers.onmicrosoft.com → use: mycompanycustomers
#           This makes the authority: https://mycompanycustomers.ciamlogin.com/
# -----------------------------------------------------------------------------
VITE_ENTRA_TENANT_SUBDOMAIN=your-tenant-subdomain-here

# -----------------------------------------------------------------------------
# VITE_API_SCOPE
# The full scope URI of the Node.js API — used when requesting an access token.
# Format:  api://<API-client-id>/<scope-name>
#
# How to find it:
#   1. Go to Entra ID → App registrations → <your API app>
#   2. Navigate to: Expose an API
#   3. Copy the Application ID URI (looks like api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
#   4. Append /SaaS.Access (the scope name you created)
#
# Example:  api://b2c3d4e5-f6a7-8901-bcde-f12345678901/SaaS.Access
# -----------------------------------------------------------------------------
VITE_API_SCOPE=api://your-api-client-id-here/SaaS.Access

# -----------------------------------------------------------------------------
# VITE_API_BASE_URL
# Base URL of the Node.js Express backend.
# For local development this is always http://localhost:4000
# Change this to your deployed API URL in production.
#
# Example (local):       http://localhost:4000
# Example (production):  https://api.yourdomain.com
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
