# =============================================================================
# BACKEND ENVIRONMENT — Microsoft Entra External ID + Express API
# Copy this file, fill in every value below, then restart the dev server.
# Never commit real values to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# PORT
# The port the Express API listens on locally.
# Must match VITE_API_BASE_URL port in frontend/.env.development
#
# Default: 4000
# -----------------------------------------------------------------------------
PORT=4000

# -----------------------------------------------------------------------------
# FRONTEND_ORIGIN
# The URL of the React frontend — used to set CORS allowed origin.
# For local dev this is always http://localhost:3000
# Change this to your deployed frontend URL in production.
#
# Example (local):       http://localhost:3000
# Example (production):  https://app.yourdomain.com
# -----------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# ENTRA_TENANT_SUBDOMAIN
# The subdomain of your External ID tenant — the part BEFORE .onmicrosoft.com
# Same value as VITE_ENTRA_TENANT_SUBDOMAIN in the frontend config.
#
# How to find it:
#   1. Go to https://entra.microsoft.com
#   2. Switch to your External ID tenant (top-right Directories menu)
#   3. Navigate to: Entra ID → Overview
#   4. Look at "Primary domain" — e.g. mycompanycustomers.onmicrosoft.com
#   5. Use only the part before .onmicrosoft.com
#
# Example:  mycompanycustomers
#           This builds the JWKS URL: https://mycompanycustomers.ciamlogin.com/<tenant-id>/v2.0/discovery/v2.0/keys
# -----------------------------------------------------------------------------
ENTRA_TENANT_SUBDOMAIN=your-tenant-subdomain-here

# -----------------------------------------------------------------------------
# ENTRA_TENANT_ID
# The Directory (tenant) ID — a GUID that uniquely identifies your Entra tenant.
# Used together with the subdomain to build the token issuer URL for JWT validation.
#
# How to find it:
#   1. Go to https://entra.microsoft.com
#   2. Switch to your External ID tenant
#   3. Navigate to: Entra ID → Overview
#   4. Copy "Directory (tenant) ID" — it is a GUID on the Overview page
#
# Example:  a1b2c3d4-e5f6-7890-abcd-ef1234567890
#           This builds the issuer: https://mycompanycustomers.ciamlogin.com/a1b2c3d4-.../v2.0
# -----------------------------------------------------------------------------
ENTRA_TENANT_ID=your-tenant-id-guid-here

# -----------------------------------------------------------------------------
# ENTRA_API_CLIENT_ID
# The Application (client) ID of the Node.js API app registration.
# The backend uses this as the expected "audience" (aud) when validating tokens.
# Every access token sent to this API must have this value in its aud claim.
#
# How to find it:
#   1. Go to https://entra.microsoft.com
#   2. Switch to your External ID tenant
#   3. Navigate to: Entra ID → App registrations → <your API app>
#   4. Copy "Application (client) ID" from the Overview page
#      (This is a DIFFERENT app from the React SPA — register them separately)
#
# Example:  b2c3d4e5-f6a7-8901-bcde-f12345678901
# -----------------------------------------------------------------------------
ENTRA_API_CLIENT_ID=your-api-client-id-here

# -----------------------------------------------------------------------------
# ENTRA_EXPECTED_SCOPE
# The scope name the backend checks inside every incoming access token (scp claim).
# Must exactly match the scope name you created under "Expose an API" in the API
# app registration. Do not include the full URI — just the short name.
#
# How to find / verify it:
#   1. Go to Entra ID → App registrations → <your API app>
#   2. Navigate to: Expose an API → Scopes defined by this API
#   3. The "Scope name" column shows the short name — e.g. SaaS.Access
#
# Default: SaaS.Access  (change only if you used a different scope name)
# -----------------------------------------------------------------------------
ENTRA_EXPECTED_SCOPE=SaaS.Access

# -----------------------------------------------------------------------------
# DB_PATH
# Path to the SQLite database file, relative to the backend/ directory.
# The file is created automatically when the server starts for the first time.
# For production, replace this with Azure SQL connection string logic.
#
# Example (local):  ./saas.db   → creates backend/saas.db
# -----------------------------------------------------------------------------
DB_PATH=./saas.db
