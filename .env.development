# =============================================================================
# SHARED ENVIRONMENT — used by both frontend (Vite) and backend (Express)
# Fill in every placeholder value before running the apps.
# Never commit real secrets to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# ── BACKEND VARIABLES ────────────────────────────────────────────────────────
# -----------------------------------------------------------------------------

# Port the Express API listens on (must match VITE_API_BASE_URL below)
PORT=4000

# URL of the React frontend — used for CORS allowed origin
# Local: http://localhost:3000 | Production: https://app.yourdomain.com
FRONTEND_ORIGIN=http://localhost:3000

# Subdomain of your External ID tenant — only the SHORT part, NOT the full domain
# Portal: entra.microsoft.com → Entra ID → Overview → Primary domain
# ✅ Correct:   fpass                       (just the subdomain)
# ❌ Wrong:     fpass.onmicrosoft.com        (the code will strip this automatically,
#               fpass.ciamlogin.com           but use the short form to avoid confusion)
ENTRA_TENANT_SUBDOMAIN=fpass.onmicrosoft.com

# Directory (tenant) ID — GUID on the Entra ID Overview page
# Portal: entra.microsoft.com → Entra ID → Overview → Directory (tenant) ID
# Example: a1b2c3d4-e5f6-7890-abcd-ef1234567890
ENTRA_TENANT_ID=c6f2f36f-9676-4f19-ac3e-0fbc8913bf82

# Application (client) ID of the Node.js API app registration
# ⚠️  This is NOT the same as VITE_ENTRA_CLIENT_ID (the SPA registration).
#     You need TWO separate app registrations — one for the React SPA and one for the API.
#     See README "Two app registrations" section for why they must be separate.
#
# How to create the API registration (if you haven't yet):
#   1. Go to entra.microsoft.com → switch to your External ID tenant
#   2. Entra ID → App registrations → New registration
#   3. Name: "SaaS API"  |  Supported account types: this org only  |  No redirect URI
#   4. Click Register → copy the Application (client) ID shown on Overview
#   5. Go to Expose an API → click Add next to Application ID URI → Save the default
#   6. Click Add a scope → Scope name: SaaS.Access → Who can consent: Admins and users → Add
#
# Portal: Entra ID → App registrations → SaaS API → Overview → Application (client) ID
# Example: b2c3d4e5-f6a7-8901-bcde-f12345678901
ENTRA_API_CLIENT_ID=2171997e-50c0-4afd-a6a9-c973b8b6e499

# Scope name defined under "Expose an API" in the API app registration
# Portal: Entra ID → App registrations → <API app> → Expose an API → Scope name
# Default: SaaS.Access (change only if you used a different name)
ENTRA_EXPECTED_SCOPE=SaaS.Access

# Path to the SQLite database file, relative to the backend/ directory
# Created automatically on first run. Use Azure SQL connection string in production.
DB_PATH=./saas.db

# -----------------------------------------------------------------------------
# ── FRONTEND VARIABLES (must be prefixed with VITE_) ─────────────────────────
# -----------------------------------------------------------------------------

# Application (client) ID of the React SPA app registration
# ⚠️  This is NOT the same as ENTRA_API_CLIENT_ID (the API registration).
#     This is the PUBLIC client — the browser app that signs the user in.
#
# How to create the SPA registration (if you haven't yet):
#   1. Entra ID → App registrations → New registration
#   2. Name: "SaaS React SPA"  |  Supported account types: this org only
#   3. Redirect URI → Platform: Single-page application → URI: http://localhost:3000
#   4. Click Register → copy the Application (client) ID shown on Overview
#   5. Go to API permissions → Add a permission → My APIs → SaaS API
#      → Delegated permissions → SaaS.Access → Add permissions
#   6. Click "Grant admin consent" if required by your tenant
#
# Portal: Entra ID → App registrations → SaaS React SPA → Overview → Application (client) ID
# Example: c3d4e5f6-a7b8-9012-cdef-123456789012
VITE_ENTRA_CLIENT_ID=31266f20-bacc-423d-a77d-6cdc2f0bccf9

# Subdomain of your External ID tenant — same value as ENTRA_TENANT_SUBDOMAIN above
# Used by MSAL to build the authority URL: https://<subdomain>.ciamlogin.com/
VITE_ENTRA_TENANT_SUBDOMAIN=fpass.onmicrosoft.com

# Full scope URI for the API access token request
# Format: api://<ENTRA_API_CLIENT_ID>/<scope-name>
# Portal: Entra ID → App registrations → <API app> → Expose an API → Application ID URI
# Example: api://b2c3d4e5-f6a7-8901-bcde-f12345678901/SaaS.Access
VITE_API_SCOPE=api://2171997e-50c0-4afd-a6a9-c973b8b6e499/SaaS.Access

# Base URL of the Express backend
# Local: http://localhost:4000 | Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:4000
